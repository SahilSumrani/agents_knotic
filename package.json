{
  "name": "release-sentinel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous release-risk agent that gates, ships, verifies and self-heals deployments via Swytchcode",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "run:once": "tsx src/cli.ts",
    "preflight": "tsx src/preflight.ts",
    "build:site": "node scripts/build-site.mjs",
    "selftest": "tsx src/selftest.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@swytchcode/runtime": "^1.1.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "openai": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
