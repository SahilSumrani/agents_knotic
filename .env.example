# Release Sentinel configuration.
# Copy to .env and fill in. Every credential below is a static token - nothing
# here uses OAuth, so none of it expires mid-demo.

# ---------------------------------------------------------------------------
# GitHub - fine-grained PAT with read access to the repo you will push to.
# https://github.com/settings/personal-access-tokens
# ---------------------------------------------------------------------------
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=release-sentinel-demo
GITHUB_BRANCH=main

# ---------------------------------------------------------------------------
# OpenAI - powers the risk verdict. Without it the agent falls back to
# deterministic heuristics and marks the verdict as degraded.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Netlify - PAT from User settings > Applications > Personal access tokens.
# The site must already exist AND be linked to the GitHub repo above, because
# the agent triggers a real build of that repo.
# NETLIFY_SITE_ID is the "Site ID" under Site configuration > General.
# ---------------------------------------------------------------------------
NETLIFY_TOKEN=nfp_xxxxxxxxxxxxxxxxxxxxxxxx
NETLIFY_SITE_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Jira Cloud - free plan is fine. Create an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL must be your site root with no trailing slash. The Swytchcode
# Jira bundle ships a placeholder endpoint, so `npm run preflight` rewrites it
# to this value before the first run.
# ---------------------------------------------------------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=ATATTxxxxxxxxxxxxxxxxxxxxxxxx
JIRA_PROJECT_KEY=SEN
JIRA_ISSUE_TYPE=Task

# ---------------------------------------------------------------------------
# Notion - internal integration token from https://www.notion.so/my-integrations
# Create a page for release reports, then share it with the integration via
# the page's "..." menu > Connections. NOTION_REPORT_PAGE_ID is the 32-char id
# in the page URL. The agent appends to this page; it does not create pages,
# because the registry's Notion bundle cannot enable page creation.
# ---------------------------------------------------------------------------
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxx
NOTION_REPORT_PAGE_ID=00000000000000000000000000000000

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
# Risk score at or above which the agent refuses to deploy.
RISK_THRESHOLD=65
# Only commits from the last N minutes count as a release candidate.
LOOKBACK_MINUTES=120
MAX_COMMITS=10
# How long to wait for a Netlify deploy before treating it as failed.
DEPLOY_TIMEOUT_MS=300000
DEPLOY_POLL_INTERVAL_MS=6000
# Reason and report, but perform no deploys. Useful for a safe first run.
AGENT_DRY_RUN=false

PORT=3000
