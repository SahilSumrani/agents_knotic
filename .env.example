# Release Sentinel configuration.
# Copy to .env and fill in. Provider tokens below are static.
#
# For a PUBLIC cloud deploy (Render / Railway / Fly), you ALSO need a
# Swytchcode service token — interactive `swytchcode login` sessions expire
# and cannot be refreshed on a headless server.
# ---------------------------------------------------------------------------
# SWYTCHCODE_TOKEN - from https://app.swytchcode.com (account / API tokens).
# Required on Render. Optional locally if you already ran `swytchcode login`.
# The CLI reads this from the process environment (Render injects it).
# ---------------------------------------------------------------------------
# SWYTCHCODE_TOKEN=swt_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# GitHub - fine-grained PAT with read access to the repo you will push to.
# https://github.com/settings/personal-access-tokens
# ---------------------------------------------------------------------------
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=release-sentinel-demo
GITHUB_BRANCH=main

# ---------------------------------------------------------------------------
# Language model - powers the risk verdict. Without it the agent falls back to
# deterministic heuristics and marks the verdict as degraded.
#
# Set GROQ_API_KEY (free, https://console.groq.com/keys) or OPENAI_API_KEY.
# Groq is OpenAI-compatible, so the same SDK is used with a different base URL.
# Strict JSON schemas are only guaranteed on openai/gpt-oss-20b and
# openai/gpt-oss-120b; other models fall back to plain JSON mode automatically.
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=openai/gpt-oss-20b
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx   # alternative to GROQ_API_KEY
# LLM_BASE_URL=https://api.groq.com/openai/v1  # only for a custom provider

# ---------------------------------------------------------------------------
# Netlify - PAT from User settings > Applications > Personal access tokens.
# The site must already exist AND be linked to the GitHub repo above, because
# the agent triggers a real build of that repo.
# NETLIFY_SITE_ID is the "Site ID" under Site configuration > General.
# ---------------------------------------------------------------------------
NETLIFY_TOKEN=nfp_xxxxxxxxxxxxxxxxxxxxxxxx
NETLIFY_SITE_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Jira Cloud - free plan is fine. Create an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL must be your site root with no trailing slash. The Swytchcode
# Jira bundle ships a placeholder endpoint, so `npm run preflight` rewrites it
# to this value before the first run.
# ---------------------------------------------------------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=ATATTxxxxxxxxxxxxxxxxxxxxxxxx
JIRA_PROJECT_KEY=SEN
JIRA_ISSUE_TYPE=Task

# ---------------------------------------------------------------------------
# Notion - internal integration token from https://www.notion.so/my-integrations
# Create a page for release reports, then share it with the integration via
# the page's "..." menu > Connections. NOTION_REPORT_PAGE_ID is the 32-char id
# in the page URL. The agent appends to this page; it does not create pages,
# because the registry's Notion bundle cannot enable page creation.
# ---------------------------------------------------------------------------
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxx
NOTION_REPORT_PAGE_ID=00000000000000000000000000000000

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
# Risk score at or above which the agent refuses to deploy.
RISK_THRESHOLD=65
# Only commits from the last N minutes count as a release candidate.
LOOKBACK_MINUTES=120
MAX_COMMITS=10
# How long to wait for a Netlify deploy before treating it as failed.
DEPLOY_TIMEOUT_MS=300000
DEPLOY_POLL_INTERVAL_MS=6000

# ---------------------------------------------------------------------------
# Post-deploy health check
# A `ready` deploy only means the build exited zero. After it publishes, the
# agent fetches the deployed URL and requires a 2xx response whose body contains
# HEALTH_CHECK_MARKER. A failure is treated exactly like a failed deploy: roll
# back to the last good deploy and file the incident.
# ---------------------------------------------------------------------------
# Set to false to accept a `ready` deploy without fetching the site.
HEALTH_CHECK_ENABLED=true
# Text that must appear in the served HTML. Default is the site's headline in
# site/index.html - change both together if you edit that heading for real.
HEALTH_CHECK_MARKER=Guarded by Release Sentinel
# Attempts before declaring the site unhealthy, and the pause between them.
# CDN propagation is not instant, but do not retry long enough to stall a demo.
HEALTH_CHECK_ATTEMPTS=4
HEALTH_CHECK_RETRY_DELAY_MS=4000
# Per-request timeout.
HEALTH_CHECK_TIMEOUT_MS=10000
# Optional: check this URL instead of the deploy's own URL.
# HEALTH_CHECK_URL=https://your-site.netlify.app
# Reason and report, but perform no deploys. Useful for a safe first run.
AGENT_DRY_RUN=false

PORT=3000
